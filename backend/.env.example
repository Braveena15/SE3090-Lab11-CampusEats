# Documentation only: ASP.NET Core does not automatically load .env files.
ConnectionStrings__Default=Host=<NEON_HOST>;Database=<DATABASE>;Username=<USERNAME>;Password=<PASSWORD>;SSL Mode=VerifyFull
Jwt__Key=<RANDOM_SECRET_AT_LEAST_32_BYTES>
Jwt__Issuer=<YOUR_ISSUER>
Jwt__Audience=<YOUR_AUDIENCE>
Cors__AllowedOrigins__0=https://<YOUR_SITE>.netlify.app
Database__ApplyMigrations=<true_OR_false>
ASPNETCORE_ENVIRONMENT=<Development_OR_Production>
PORT=<HOST_PORT>
